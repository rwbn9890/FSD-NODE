<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" >
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
    <form action="/insertData" method="POST">
        <table style="width:400px" align="center"  class="table table-bordered">
            <tr>
                <input type="text" hidden name="id" value="<%= editData.id %>">
                <th>name</th>
                <td><input name="name" type="text" value="<%=editData.name %>"></td>
            </tr>
            <tr>
                <th>email</th>
                <td><input name="email" type="text" value="<%=editData.email %>"></td>
            </tr>
            <tr>
                <th>phone</th>
                <td><input name="phone" type="number" value="<%=editData.phone %>"></td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>
                    <input name="gender" type="radio" <% if(editData.gender == "male"){ %> checked <% } %> value="male" />
                    <label>Male</label>
                    <input name="gender" type="radio" <% if(editData.gender == "female"){ %> checked <% } %> value="female" />
                    <label>female</label>
                    <input name="gender" type="radio" <% if(editData.gender == "other"){ %> checked <% } %> value="other" />
                    <label>Other</label>
                </td>
            </tr>
            <tr>
                <th>Skills</th>
                <td>
                    <% ["html", "css", "javascript", "React", "Node", "Typescript"].map((el)=>{ %>
                        <input name="skills"  type="checkbox" value="<%= el %>" />
                        <label><%= el %></label>
                        <%})%>
                </td>
            </tr>
            <tr>
                <th>password</th>
                <td><input name="password" type="text" value="<%=editData.password %>"></td>
            </tr>
            <tr>
                <th colspan="2">
                    <button>
                        <% if(editData.id){ %>
                            Edit
                        <% } else { %>
                            Submit
                        <% } %>
                    </button>
                </th>
            </tr>
        </table>
    </form>


    <div class="container my-5">
        <table class="table">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Gender</th>
                <th>Password</th>
                <th>Delete</th>
            </tr>
            <%  data.map((ele)=>{ %>
                <tr>
                    <td><%= ele.name %></td>
                    <td><%= ele.email %></td>
                    <td><%= ele.phone %></td>
                    <td><%= ele.gender %></td>
                    <td><% ele.skills.map((sk)=>{ %> <%= sk %> <%}) %></td>
                    <td><%= ele.password %></td>
                    <td>
                        <a class="btn btn-sm rounded-circle btn-outline-secondary" href="/edit?id=<%= ele.id %>"><i class="bi bi-pencil"></i></a>

                        <!-- <a class="btn btn-sm rounded-circle btn-outline-secondary" href="/delete?id=<%= ele.id %>"><i class="bi bi-trash"></i></a> -->
                        <a class="btn btn-sm rounded-circle btn-outline-secondary" href="/delete/<%= ele.id %>"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            <%    }) %>
        </table>
    </div>
</body>
</html>